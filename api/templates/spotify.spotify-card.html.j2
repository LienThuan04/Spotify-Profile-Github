{% from 'spotify._shared.html.j2' import styles, logo, equalizer, progress, empty_art with context %}
<svg xmlns="http://www.w3.org/2000/svg" width="400" height="{{height}}" viewBox="0 0 400 {{height}}" role="img">
  <title>Spotify — {{title_text}}: {{song_name}} — {{artist_name}}</title>
  <foreignObject width="400" height="{{height}}">
    <div xmlns="http://www.w3.org/1999/xhtml" class="sp spotify-card{% if title_text == 'Not playing' %} offline{% endif %}">
      <style>
        {{styles()}}
        .spotify-card { padding: 20px; display: flex; gap: 16px; align-items: center; }
        .art { width: 160px; height: 160px; }
        .details { display: flex; flex-direction: column; gap: 6px; }
        .equalizer-row { margin-top: 2px; height: 12px; display: flex; align-items: center; }
        .progress { margin-top: 8px; }
      </style>
      {% if cover_image %}<img class="art" src="data:image/png;base64,{{img}}" alt="Album cover"/>{% elif title_text == 'Not playing' %}{{empty_art()}}{% endif %}
      <div class="details">
        <div class="label">{{logo()}}<span>{{title_text|upper}}</span></div>
        <div class="song">{{song_name}}</div>
        <div class="artist">{{artist_name}}</div>
        {% if title_text != 'Not playing' and eq_style|default('bars') != 'none' %}<div class="equalizer-row">{{equalizer()}}</div>{% endif %}
        {{progress()}}
      </div>
    </div>
  </foreignObject>
</svg>
