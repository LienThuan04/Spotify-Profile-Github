{% from 'spotify._shared.html.j2' import styles, logo, equalizer, progress, empty_art with context %}
<svg xmlns="http://www.w3.org/2000/svg" width="400" height="{{height}}" viewBox="0 0 400 {{height}}" role="img">
  <title>Spotify — {{title_text}}: {{song_name}} — {{artist_name}}</title>
  <foreignObject width="400" height="{{height}}">
    <div xmlns="http://www.w3.org/1999/xhtml" class="sp spotify-vinyl{% if title_text == 'Not playing' %} offline{% endif %}">
      <style>
        {{styles()}}
        {% if cover_image and img %}
        :root, .spotify-vinyl { --cover: url('data:image/png;base64,{{img}}'); }
        {% endif %}
        .spotify-vinyl {
          padding: 20px; display: flex; gap: 18px; align-items: center; position: relative;
        }
        .deck {
          position: relative; width: 156px; height: 156px; flex-shrink: 0;
          display: flex; align-items: center; justify-content: center;
        }
        .disc {
          position: relative; width: 150px; height: 150px; border-radius: 50%;
          {% if cover_image and img %}
          /* picture disc: the whole record is the album cover */
          background: var(--cover) center/cover no-repeat, #121212;
          {% else %}
          background: repeating-radial-gradient(circle at center, #181818 0, #181818 2px, #0e0e0e 3px, #0e0e0e 4px);
          {% endif %}
          box-shadow: rgba(0,0,0,.6) 0 8px 24px, inset rgba(255,255,255,.05) 0 0 0 2px;
          display: flex; align-items: center; justify-content: center;
          animation: vinyl-spin 7s linear infinite;
        }
        {% if cover_image and img %}
        .disc::before {
          content: ""; position: absolute; inset: 0; border-radius: 50%;
          background: repeating-radial-gradient(circle at center, rgba(0,0,0,.22) 0 1px, transparent 1px 3px);
          box-shadow: inset 0 0 0 3px rgba(0,0,0,.55);
        }
        .sheen {
          position: absolute; width: 150px; height: 150px; border-radius: 50%; pointer-events: none;
          background: linear-gradient(135deg, rgba(255,255,255,.22) 0%, rgba(255,255,255,0) 38%, rgba(255,255,255,0) 62%, rgba(255,255,255,.10) 100%);
        }
        {% endif %}
        @keyframes vinyl-spin { to { transform: rotate(360deg); } }
        .label-circle {
          position: relative; border-radius: 50%;
          display: flex; align-items: center; justify-content: center;
          {% if cover_image and img %}
          width: 30px; height: 30px; background: rgba(18,18,18,.85);
          box-shadow: 0 0 0 2px rgba(255,255,255,.15);
          {% else %}
          width: 58px; height: 58px; background: #282828;
          box-shadow: inset 0 0 0 1px rgba(0,0,0,.5);
          {% endif %}
        }
        .spindle-hole {
          width: 8px; height: 8px; border-radius: 50%; background: #000;
          border: 1.5px solid #666;
        }
        .tonearm {
          position: absolute; top: 0; right: 0; width: 44px; height: 100px;
          pointer-events: none; transform-origin: 34px 12px;
          transform: rotate(18deg);
        }
        {% if not is_now_playing %}
        .disc { animation: none !important; }
        .tonearm { transform: rotate(0deg); }
        {% endif %}
        .details { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 0; }
        .equalizer-row { margin-top: 2px; height: 12px; display: flex; align-items: center; }
        .progress { margin-top: 8px; }
      </style>
      <div class="deck">
        <div class="disc">
          <div class="label-circle">
            <div class="spindle-hole"></div>
          </div>
        </div>
        {% if cover_image and img %}<div class="sheen"></div>{% endif %}
        <svg xmlns="http://www.w3.org/2000/svg" class="tonearm" viewBox="0 0 44 100" aria-hidden="true">
          <circle cx="34" cy="12" r="8" fill="#252525" stroke="#4d4d4d" stroke-width="1.5"/>
          <circle cx="34" cy="12" r="3.5" fill="#7c7c7c"/>
          <path d="M34 12 L30 55 L16 82 L12 88" fill="none" stroke="#bbb" stroke-width="2" stroke-linecap="round"/>
          <rect x="6" y="84" width="9" height="5" rx="1" transform="rotate(-30 10.5 86.5)" fill="#1ed760"/>
        </svg>
      </div>
      <div class="details">
        <div class="label">{{logo()}}<span>{{title_text|upper}}</span></div>
        <div class="song">{{song_name}}</div>
        <div class="artist">{{artist_name}}</div>
        {% if title_text != 'Not playing' and eq_style|default('bars') != 'none' %}<div class="equalizer-row">{{equalizer()}}</div>{% endif %}
        {{progress()}}
      </div>
    </div>
  </foreignObject>
</svg>